# Copier en /etc/tordns/client.env (0600) ou en .env local (ignoré par git).
# Adresse du service caché TorDNS — jamais celle de production dans le dépôt.
TORDNS_ONION=

# Proxy SOCKS5 du démon Tor local.
TORDNS_SOCKS=127.0.0.1:9050

# Écoute DNS locale. Le port 53 exige CAP_NET_BIND_SERVICE (voir l'unité systemd).
TORDNS_ECOUTE=127.0.0.1:53

# Taille du cache LRU en mémoire.
TORDNS_CACHE=4096
