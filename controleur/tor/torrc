# TorDNS — torrc du contrôleur Onionbalance (Missions 9 et 10).
# Tor sert à la fois client (onionbalance lit les descripteurs, le registre
# joint les instances) et service caché (API du registre). Aucun port publié :
# le SOCKS et le contrôle n'écoutent que sur le réseau docker privé.

SocksPort 0.0.0.0:9050
DataDirectory /var/lib/tor

# Socket Unix, jamais exposé au réseau (stem n'accepte que des adresses IP
# pour un port TCP). onionbalance tourne avec le même uid/gid que Tor et lit
# le cookie par le dossier de données partagé.
ControlPort 0
ControlSocket /var/lib/tor/control_socket
CookieAuthentication 1
CookieAuthFile /var/lib/tor/control_auth_cookie
CookieAuthFileGroupReadable 1

# Service caché du registre communautaire (Mission 10) : API d'inscription et
# page publique. Il est distinct de l'adresse maîtresse et de l'adresse
# communauté ; sa clé est générée par Tor dans ce dossier, hors dépôt.
HiddenServiceDir /var/lib/tor/registre
HiddenServiceVersion 3
# Cible par IP fixe (et non par nom) : Tor refuse une cible dont le nom
# n'est pas encore résolvable au démarrage. Le registre attend pourtant que
# Tor soit sain : l'IP fixe du compose casse ce cycle.
HiddenServicePort 80 172.28.58.10:8080
HiddenServiceExportCircuitID haproxy
HiddenServiceMaxStreams 64
HiddenServiceMaxStreamsCloseCircuit 1
VanguardsLiteEnabled 1

Log warn stdout
SafeLogging 1
