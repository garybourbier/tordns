[Unit]
Description=containerd (binaires statiques Docker, image TorDNS)
Documentation=https://docs.docker.com/engine/
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
Delegate=yes
KillMode=process
Restart=always
RestartSec=5
ExecStart=/usr/local/bin/containerd
ExecReload=/bin/kill -s HUP $MAINPID
LimitNOFILE=1048576
LimitNPROC=infinity
LimitCORE=infinity
TasksMax=infinity
OOMScoreAdjust=-999

[Install]
WantedBy=multi-user.target
