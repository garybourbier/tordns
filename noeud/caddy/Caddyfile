# TorDNS — front HTTP du nœud installable (Mission 8).
# Joignable uniquement depuis le réseau docker privé, lui-même exposé
# exclusivement par le service caché Tor.
{
	admin off
	auto_https off

	# Tor précède chaque connexion d'un en-tête PROXY v2 qui encode le
	# circuit ; Caddy le lit et remplace l'adresse distante. Seul le réseau
	# privé du nœud peut fournir cet en-tête.
	servers {
		listener_wrappers {
			proxy_protocol {
				timeout 5s
				# CIDR privé du nœud (compose le passe dans TORDNS_RESEAU_CIDR).
				allow {$TORDNS_RESEAU_CIDR}
				fallback_policy ignore
			}
		}
	}
}

http://:8080 {
	# Aucun journal d'accès : ni IP, ni URL, ni en-tête.
	log {
		output discard
	}

	handle /healthz {
		reverse_proxy passerelle:8053
	}

	handle /dns-query {
		reverse_proxy passerelle:8053 {
			# Identifiant de circuit issu du PROXY v2, non falsifiable.
			header_up X-TorDNS-Circuit {http.request.remote.host}
			header_up -X-Forwarded-For
			header_up -X-Forwarded-Proto
			header_up -X-Forwarded-Host
			header_up -X-Real-IP
		}
	}

	# Page d'état publique : version, état des services, charge grossière.
	# Le service `etat` ne lit aucun journal et ne compte aucune requête.
	handle /.well-known/tordns/etat {
		reverse_proxy etat:8081
	}

	# Miroir des mises à jour signées : le dernier manifeste et les fichiers
	# publiés, déposés par Gary dans /var/lib/tordns/maj. Aucun listage de
	# dossier ; les clients vérifient de toute façon signature et empreinte.
	handle_path /maj/* {
		root * /srv/maj
		file_server {
			browse false
		}
		header Cache-Control "no-store"
	}

	handle {
		respond "TorDNS — DoH uniquement sur /dns-query" 404
	}
}
