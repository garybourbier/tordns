# Secrets et clés — jamais versionnés (règle absolue du projet)

# Clés et configuration du service caché Tor v3 (Mission 2)
serveur/cles-onion/
serveur/tor/keys/
serveur/tor/hidden_service*/
**/hs_ed25519_secret_key
**/hs_ed25519_public_key
**/hostname

# Adresses .onion de production : jamais dans le dépôt
*.onion

# Clés, certificats et variables d'environnement locales
*.key
*.pem
.env
.env.*
!.env.example

# Pool et données du contrôleur Onionbalance (Mission 9)
controleur/pools/*.txt
!controleur/pools/coeur.txt.example

# Artefacts de compilation locaux et de CI
dist/

# Python (pilote QEMU)
__pycache__/
