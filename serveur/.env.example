# Copier en `.env` (ignoré par git) et adapter si besoin.
#
# Limite de débit par circuit Tor (la passerelle lit X-TorDNS-Circuit, rempli
# par Caddy depuis le PROXY v2 de Tor). Table bornée, purge toutes les 30 s.
LIMITE_CIRCUIT_REQ_S=20
LIMITE_CIRCUIT_RAFALE=40
LIMITE_CIRCUITS_MAX=4096
LIMITE_CIRCUIT_TTL=120

# Plafond global, tous circuits confondus, et parallélisme.
LIMITE_REQ_S=200
LIMITE_RAFALE=400
MAX_CONCURRENTS=64

# Aucun port SOCKS n'est publié par le nœud. Les preuves démarrent un client
# Tor séparé : docker compose --profile test up -d tor-client
