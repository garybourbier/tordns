# TorDNS — front HTTP interne.
# En Mission 2, ce service sera exposé exclusivement en service caché Tor v3 :
# le trafic est déjà chiffré et authentifié par Tor, donc HTTP en clair ici.
{
	admin off
	auto_https off

	# Tor précède chaque connexion au service caché d'un en-tête PROXY v2
	# (HiddenServiceExportCircuitID haproxy) dont l'adresse source encode
	# l'identifiant de circuit. Caddy le lit et remplace l'adresse distante.
	# Seul le réseau docker privé peut fournir un tel en-tête ; une connexion
	# locale sans en-tête (healthcheck) reste acceptée.
	servers {
		listener_wrappers {
			proxy_protocol {
				timeout 5s
				allow 172.28.53.0/24
				fallback_policy ignore
			}
		}
	}
}

http://:8080 {
	# Aucun journal d'accès : sortie explicitement jetée. Caddy n'écrit donc
	# ni IP, ni URL, ni en-tête de requête.
	log {
		output discard
	}

	handle /healthz {
		reverse_proxy passerelle:8053
	}

	handle /dns-query {
		reverse_proxy passerelle:8053 {
			# Identifiant de circuit issu du PROXY v2 de Tor. header_up
			# remplace toute valeur fournie par le client : impossible de
			# choisir son seau depuis l'extérieur.
			header_up X-TorDNS-Circuit {http.request.remote.host}
			# Ne transmettre aucune métadonnée client inutile.
			header_up -X-Forwarded-For
			header_up -X-Forwarded-Proto
			header_up -X-Forwarded-Host
			header_up -X-Real-IP
		}
	}

	handle {
		respond "TorDNS — DoH uniquement sur /dns-query" 404
	}
}
